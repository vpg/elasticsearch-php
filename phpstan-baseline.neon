parameters:
	ignoreErrors:
		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Elasticsearch/ClientBuilder.php

		-
			message: '#^Method Elasticsearch\\Transport\:\:resultOrFuture\(\) should return array\|\(callable\) but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: src/Elasticsearch/Transport.php
